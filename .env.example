# Byditors Cut settings. Copy to .env (start.bat / start.sh do it for you) and fill in what you need.
# Everything is optional except ffmpeg being installed. Never commit .env.

# ---------- the app ----------
BCUT_PORT=8777
# BCUT_DATA=./data                  # where videos, clips and the database live

# ---------- speech to text (runs on your PC, needs: pip install faster-whisper) ----------
BCUT_WHISPER_MODEL=small            # tiny / base / small / medium / large-v3. Bigger = better + slower
BCUT_WHISPER_DEVICE=auto            # auto picks your NVIDIA GPU if there is one
BCUT_WHISPER_LANGUAGE=              # empty = detect. "hi" for Hindi/Hinglish streams

# ---------- AI that picks clips + writes hooks/captions (or set it in the dashboard) ----------
# openai | gemini | groq | openrouter | xai | anthropic | ollama | custom
BCUT_AI_PROVIDER=
BCUT_AI_MODEL=
BCUT_AI_KEY=
BCUT_AI_BASE_URL=                   # only for "custom"

# ---------- clips ----------
BCUT_CLIP_MIN=15
BCUT_CLIP_MAX=60
BCUT_CLIPS_PER_VIDEO=6
BCUT_CAPTION_FONT=Anton             # Anton, Archivo Black or Poppins ExtraBold (bundled)
BCUT_CREDIT_OVERLAY=1               # small "@creator" tag on clips of other people's content

# ---------- streamer radar + live clipping ----------
BCUT_RADAR_EVERY_SEC=120
BCUT_LIVE_BUFFER_MIN=30             # minutes of each live stream kept on disk
BCUT_LIVE_MAX_PARALLEL=3            # streams recorded at the same time
BCUT_LIVE_CLIP_COOLDOWN_SEC=90      # at most one auto clip per this many seconds per stream
# Optional official APIs = faster, more reliable live checks (dev.kick.com, dev.twitch.tv)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------- Rights & Safety Guard ----------
AUDD_API_TOKEN=                     # names copyrighted songs (audd.io). Strongly recommended for auto-posting
OPENAI_MODERATION_KEY=              # free moderation model for hate/sexual/violence (any OpenAI key)
BCUT_MUSIC_REVIEW_SHARE=0.15        # share of a clip that is music before it needs a look
BCUT_MUSIC_BLOCK_SHARE=0.55         # ...before it is blocked
BCUT_STRIP_MUSIC=1

# ---------- posting ----------
BCUT_POST_GAP_MIN=90                # minutes between posts on one account
BCUT_POST_DAILY_CAP=6               # posts per account per day
BCUT_QUIET_HOURS=01-07              # local hours with no posting ("" = none)
BCUT_GRAPH_VERSION=v21.0            # Meta Graph API version for Instagram/Facebook

# YouTube (Google Cloud → OAuth client "Web application", redirect http://127.0.0.1:8777/oauth/youtube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok (developers.tiktok.com → app with Content Posting API + Login Kit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
